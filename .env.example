# Copy to .env in the repo root, next to docker-compose.yml, and fill in. Never commit .env.
# The deployment does not start while a password or key is empty, shorter than
# 16 characters or still an example value (pki/preflight.sh); make them with
# openssl rand -hex 24.
#
# Values containing "$" MUST be in single quotes, otherwise Compose treats
# "$..." as a variable and mangles the value.

# --- HTTP entry (gateway) ---
# The deployment's domain: the gateway gets its TLS certificate for it (Let's Encrypt, 80/443).
SITE_ADDRESS=deployment.example.org
# Only behind your own TLS proxy (compose.behind-proxy.yml): local port of the gateway.
PUBLIC_PORT=8101
# Rate limits of the gateway, requests a minute: per operator key, and without a key per address.
# RATE_LIMIT_PER_MIN=600
# RATE_LIMIT_ANON_PER_MIN=60
# RATE_LIMIT_KEYED_ADDR_PER_MIN=1200   # requests with a key, per client address
# Behind your own proxy the client address comes from X-Forwarded-For of a trusted
# proxy (compose.behind-proxy.yml: private_ranges); set TRUSTED_PROXIES to narrow it.

# --- MQTT over TLS for the devices (client certificates) ---
PUBLIC_TCP_PORT=8883

# --- names ---
# DNS name devices connect to; goes into the broker certificate.
BROKER_DNS=deployment.example.org
# Optional extra IPs for the certificate (space separated), e.g. for tests by address.
BROKER_IPS=

# --- PostgreSQL ---
POSTGRES_DB=imatra
POSTGRES_USER=imatra
POSTGRES_PASSWORD=change-me

# --- device admission (pki/pki-init.sh) ---
# own:   the deployment's own CA (no service layer); device certificates:
#          docker compose run --rm -T pki-init device dev-01 > dev-01.pem   (key + certificate)
#          docker compose run --rm -T pki-init sign dev-01 < device.csr > dev-01.crt
#          docker compose run --rm -T pki-init ca > ca.crt                         (devices pin it)
# layer: the CA of this cloud and the broker certificate from the service layer; devices get
#        7-day certificates from the layer and renew them daily:
#          docker compose run --rm -v "$PWD/from-layer:/in:ro" pki-init import
PKI_MODE=own
# DEVICE_CERT_DAYS=365   # PKI_MODE=own: validity of the certificates issued here

# --- MQTT: the services' account (listener 1883, compose network only) ---
MQTT_SERVER_PASSWORD=change-me

# --- ISO 15118 engine: station defaults (a device's own config overrides them) ---
EVSE_MAX_CURRENT_A=32
EVSE_NOMINAL_VOLTAGE_V=230
EVSE_PHASES=3
# ISO 15118-20 AC (EIM): offered in the handshake, before ISO 15118-2, on TLS 1.3 connections
# to the EV (ADR-004). Off until tested with your devices and vehicles.
# ISO20_ENABLED=false

# --- operator API (/v1/*) ---
# Keys live in the database with rights read, control, debug:
#   docker compose exec api python -m app.keys create vpp --rights read,control
#   docker compose exec api python -m app.keys list | revoke NAME
# Keys here (name:key pairs, 16+ characters) are taken over at start with ALL
# rights - for a first start only; replace them by keys with rights (keys table) once in use.
# A key removed from here is revoked at the next start of the API (docker compose up -d api).
# openssl rand -hex 24
OPERATOR_API_KEYS="admin:replace-with-openssl-rand-hex-24"

# --- device settings sent in dev/<id>/config (a device's own "device" settings override them) ---
# DEVICE_LOOP_SAMPLE_S=30     # T: forward a cache hit at most once per T s (0 = every one, debugging)
# DEVICE_TTL_S=1200           # TTL of the cache pair and limit commands
# DEVICE_TTL_RENEW_S=300      # engine renews the TTL this often while a pair is active (well below DEVICE_TTL_S)
# DEVICE_HEARTBEAT_S=60       # status period, also the loop_active window
# DEVICE_TERM_BACKUP_S=5      # local termination must finish within this
# DEVICE_TRACE=true           # per-frame timing from the device (diagnostics)
# DEVICE_CACHE=true           # false: every loop request goes to the server (comparison runs)
# DEVICE_DIGITAL_MODE=true    # 5 % to the EV (HLC); false = transit, basic charging on the charger PWM
# DEVICE_HLC_WAIT_S=30        # digital mode: no V2G connection from the EV in this time -> basic (charger PWM)
# DEVICE_SOC_FINAL=true       # DIN-only EV: read the SoC again when it stops charging (battery capacity)
# DEVICE_SOC_FINAL_WAIT_S=20  # ... after this long in B
# DEVICE_TELEMETRY_S=60       # metering report period while current flows (a 1 A change is sent at once);
#                         # (60 s keeps the database small at fleet scale)

# --- engines and the operator event feed ---
# One engine by default; the reference configuration (5 000 devices on 2 vCPU, docs/architecture.md) runs two:
#   docker compose up -d --scale engine=2
# VALKEY_ADDR=valkey:6379
# MQTT_SHARE_GROUP=engine     # name of the engines' shared subscription ($share/engine/...)
# EVENTS_STREAM_MAX=500000    # event stream in Valkey: entries not yet stored kept at most (relay enforces,
#                             # reports a gap); ~200 bytes each: must fit in VALKEY_MAXMEMORY with the sessions
# EVENTS_STREAM_HOURS=48      # ... and hours at most
# EVENTS_RETENTION_DAYS=30    # operator feed (domain_events) kept in Postgres
# HISTORY_RETENTION_DAYS=30   # telemetry, twin journal (events), V2G journal (messages); 0 keeps everything
# POWER_CHANGE_W=300          # power.changed when the power moved by this much

# --- the reference machine (2 vCPU, 8 GB RAM, NVMe) for a fleet in the thousands ---
# The values of the capacity measurement (docs/architecture.md, 5 000 devices).
# The defaults in docker-compose.yml fit a small VPS.
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=3GB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=256MB
# PG_MAX_WAL_SIZE=4GB
# PG_SHM_SIZE=256m
# PG_MEM_LIMIT=2g
# PG_MAX_CONNECTIONS=150      # per engine 12 + 3 (BG_DB_CONNS), projector 7, relay 2, API 10 per process
# VALKEY_MAXMEMORY=768mb      # sessions and pool ~50 MB; the rest: stream backlog while no relay runs
# VALKEY_MEM_LIMIT=1g
# EVENTS_STREAM_MAX=2000000   # ~400 MB of backlog
# MQTT_MEM_LIMIT=768m
# ENGINE_MEM_LIMIT=512m
# ENGINE_WORKERS=32           # per-device workers per engine
# JOURNAL_MODE=flag           # full V2G journal only for devices with the debug flag; all: every device (small bench)
# BG_DB_CONNS=3               # engine's pool for history writes (twin, telemetry, presence)
