<mxfile host="app.diagrams.net" version="26.0.9"><diagram name="C4 L1 — Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1080" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;ISO 15118 server: system context (C4 level 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Edition 17.11.2026; checked against the code at commit 3e02749&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1720" height="50" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Electric vehicle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ISO 15118-2, DIN 70121 or PWM only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="280" height="100" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Charging station&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;IEC 61851: PWM on the CP line&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="280" height="100" as="geometry"/></mxCell><mxCell id="dv" value="&lt;b&gt;Devices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;adapter between station and EV, or a station module: CP logic, SLAC, V2G tunnel, Charging Loop cache, metering&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="260" width="300" height="240" as="geometry"/></mxCell><mxCell id="im" value="&lt;b&gt;ISO 15118 server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[software system; open source, Apache 2.0]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cloud SECC of one operator deployment: answers EVs, holds sessions, applies limits and activations, keeps the registry, the event feed and the API&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="320" height="150" as="geometry"/></mxCell><mxCell id="ly" value="&lt;b&gt;Service layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external; optional; not part of this repository]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;device identity, cloud root and certificates, bindings, business rules, TLS signer&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="320" height="150" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Operator systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;VPP, planning, flexibility services; OpenADR and OCPP adapters (separate projects)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="115" width="260" height="100" as="geometry"/></mxCell><mxCell id="sf" value="&lt;b&gt;Operator staff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[person]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;API keys, registry script, metrics&lt;/span&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=13;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="290" width="260" height="90" as="geometry"/></mxCell><mxCell id="te" value="&lt;b&gt;Test environment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external system; test only]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;test harness and load generator&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1460" y="560" width="260" height="100" as="geometry"/></mxCell><mxCell id="e2" value="PLC: SLAC, ISO 15118-2&lt;br&gt;or DIN 70121" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1667;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="ev" target="dv"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="CP: station PWM;&lt;br&gt;phases pass through" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8750;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="st" target="dv"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="MQTT over mTLS, port 8883:&lt;br&gt;the whole ISO 15118 session" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="dv" target="im"><mxGeometry x="0.2346" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="165"/></Array></mxGeometry></mxCell><mxCell id="e5" value="MQTT over mTLS, not through the server:&lt;br&gt;7-day certificate, TLS signature, mirror" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="dv" target="ly"><mxGeometry x="0.3034" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="635"/></Array></mxGeometry></mxCell><mxCell id="e6" value="binding registry&lt;br&gt;(MQTT over mTLS, 8883)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ly" target="im"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="HTTPS /v1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="op" target="im"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="CLI, /metrics" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.8333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sf" target="im"><mxGeometry x="-0.6923" relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="335"/><mxPoint x="1380" y="215"/></Array></mxGeometry></mxCell><mxCell id="e9" value="in place of devices, EVs,&lt;br&gt;service layer and operator:&lt;br&gt;MQTT over mTLS 8883, HTTPS /v1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="te" target="im"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="470"/><mxPoint x="1300" y="470"/></Array></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;Scope.&lt;/b&gt; One operator deployment. The design is sized for 20 000 devices; this edition is stated for 5 000 devices with 3 200 charging sessions at once on 2 dedicated vCPU / 8 GB (measured 16–17.11.2026, docs/architecture.md). The EV talks ISO 15118 with the cloud SECC; the device only tunnels the frames and answers the Charging Loop from its cache. The server never calls the service layer: the layer publishes the registry into the deployment&#x27;s broker, and a device is admitted by a certificate under this deployment&#x27;s own root. Without the layer (PKI_MODE=own) the operator runs the deployment&#x27;s own CA and the registry script. Frequency containment reserve is not served (it needs a local reaction to grid frequency). Protocol adapters (OpenADR, OCPP) are separate projects that use /v1 and the event feed. The test environment is outside the server and is shown without detail. Contracts carry no product names.&lt;br&gt;&lt;b&gt;Key.&lt;/b&gt; Blue: the server and its parts (dark: the system; middle: containers; light: components); grey: outside the server (dashed border: test only); dark blue: a person; white: a runtime node. Solid line: request or message in normal work; dashed: asynchronous delivery, one-time setup or test only; two arrowheads: both ways." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1680" height="117" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4 L2 — Containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1180" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;ISO 15118 server: containers (C4 level 2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Edition 17.11.2026; checked against the code at commit 3e02749&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="2280" height="50" as="geometry"/></mxCell><mxCell id="b2" value="ISO 15118 server [one operator deployment]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontSize=13;fontStyle=1;fontColor=#555555;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1680" height="600" as="geometry"/></mxCell><mxCell id="pki" value="&lt;b&gt;pki-init, mqtt-init&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[one-shot]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;own: the deployment&amp;#x27;s CA; layer: imports the cloud root and broker certificate; broker passwords and ACL&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="240" height="110" as="geometry"/></mxCell><mxCell id="vk" value="&lt;b&gt;Valkey 8&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[single thread, AOF every second]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sessions, station state, plug-in records, pool, event stream, activation jobs, leader lease&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="110" width="240" height="110" as="geometry"/></mxCell><mxCell id="rl" value="&lt;b&gt;relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;event stream → domain_events; at least once, deduplicated, gaps reported&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="240" height="110" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;MQTT broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Mosquitto 2; MQTT 3.1.1, v5 clients accepted]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;8883: mTLS under the deployment&amp;#x27;s root, ACL by CN (device: dev/{id}/#; layer: write registry/#); 1883 internal&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="en" value="&lt;b&gt;Engine × N&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Go + libcbv2g, stateless]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;V2G state machine, rules, limits, activation sends; leader: scheduler, TTL renewal, registry&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Postgres 16&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;commands; devices with binding and rules; feed; operator tables; history&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Operator API /v1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Python, FastAPI]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reads, feed by cursor, limits, activations, block, device settings; keys with rights, audit, OpenAPI&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Caddy]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the only HTTP entry: TLS; /v1 and /health only; 600 requests a minute per key (default)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;Projector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Go, one active]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;feed → device_live, session_summaries, sessions, attributes; rebuildable&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="240" height="110" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;ADR-002.&lt;/b&gt; Everything needed to run a session is in Valkey; the answer to the EV uses Valkey and MQTT only. Postgres holds records, history and read tables, filled in the background (API data trail the devices by about 2 s, up to 5 s). Commands go to Postgres first, then into Valkey. Losing Valkey ends running digital sessions (FAILED_UnknownSession); limits, settings and the pool are rebuilt from Postgres." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="580" height="95" as="geometry"/></mxCell><mxCell id="te" value="&lt;b&gt;Test environment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external system; test only]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;test harness and load generator&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="dx" value="&lt;b&gt;Devices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MQTT 3.1.1 over TLS, client certificate under the deployment&amp;#x27;s root&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="200" height="100" as="geometry"/></mxCell><mxCell id="lx" value="&lt;b&gt;Service layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;service certificate, CN layer: may write registry/# only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="200" height="110" as="geometry"/></mxCell><mxCell id="ox" value="&lt;b&gt;Operator systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;HTTPS /v1, API keys with rights&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="2060" y="310" width="220" height="100" as="geometry"/></mxCell><mxCell id="e3" value="mTLS 8883&lt;br&gt;(and /v1)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="te" target="mq"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="160"/><mxPoint x="280" y="324"/></Array></mxGeometry></mxCell><mxCell id="e4" value="mTLS 8883" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="dx" target="mq"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="mTLS 8883:&lt;br&gt;registry/…" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="lx" target="mq"><mxGeometry x="-0.3547" relative="1" as="geometry"><Array as="points"><mxPoint x="460.0" y="575"/></Array></mxGeometry></mxCell><mxCell id="e6" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ox" target="gw"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="certificates, ACL" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="pki" target="mq"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="dev/…,&lt;br&gt;registry/…" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="mq" target="en"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="state + events&lt;br&gt;in one Lua call" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="en" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="XREADGROUP" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rl" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="domain_events" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rl" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="background&lt;br&gt;writes; LISTEN" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="en" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="reads, commands,&lt;br&gt;NOTIFY" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="api" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="HTTP" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gw" target="api"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="feed → tables" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="pr" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="&lt;b&gt;Message rates&lt;/b&gt; (defaults; DEVICE_* settings are sent to the device in dev/{id}/config). Device → engine: v2g/up per EV request, Charging Loop sampled once in 30 s; cp on change; telemetry/energy every 60 s while current flows and at once on a 1 A change; status every 60 s; cmd/ack per command. Engine → device: v2g/down per request; cl/push on a new limit; ctrl (TTL renewal) every 300 s while a pair is active, TTL 1 200 s.&lt;br&gt;&lt;b&gt;Background writes&lt;/b&gt; of every engine (own pool, BG_DB_CONNS): twin journal 100 ms, acknowledgements 150 ms, telemetry 200 ms, presence 500 ms. relay: batches of up to 1 000, 1 s wait. Projector: at once when there is news, else every 200 ms. Leader: activation scheduler, TTL renewal, registry intake, feed retention (30 days).&lt;br&gt;&lt;b&gt;Shared subscription.&lt;/b&gt; Engines take device topics through $share/engine: any instance serves any message; one device&#x27;s messages are ordered inside an instance, and a step is saved with a version check (ADR-001). Event time is the server&#x27;s (ADR-003).&lt;br&gt;&lt;b&gt;Registry.&lt;/b&gt; The leader reads the retained registry/dev/{id} messages with a plain subscription, applies a message only if its binding_ver is higher, and reads them all again when the leader changes.&lt;br&gt;&lt;b&gt;Key.&lt;/b&gt; Blue: the server and its parts (dark: the system; middle: containers; light: components); grey: outside the server (dashed border: test only); dark blue: a person; white: a runtime node. Solid line: request or message in normal work; dashed: asynchronous delivery, one-time setup or test only; two arrowheads: both ways." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="2240" height="117" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4 L3 — Engine: session path"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Engine: components (C4 level 3), part 1 — the session path, every instance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Edition 17.11.2026; checked against the code at commit 3e02749&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1680" height="50" as="geometry"/></mxCell><mxCell id="b2" value="Engine instance [Go]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontSize=13;fontStyle=1;fontColor=#555555;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="1040" height="580" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;MQTT broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Mosquitto]&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="260" height="70" as="geometry"/></mxCell><mxCell id="vk" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;session state, station state, plug-in records, pool, event stream&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="220" width="240" height="490" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;telemetry, twin journal, presence, acknowledgements&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="830" width="260" height="110" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Device dispatcher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[workers.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;32 workers by device hash: one device in order, devices in parallel; server time on arrival&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="260" height="110" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;V2G state machine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[internal/secc, internal/exi; libcbv2g]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ISO 15118-2 AC, DIN 70121 SoC; the answer and the cache pair; FAILED_UnknownSession&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="260" height="110" as="geometry"/></mxCell><mxCell id="ss" value="&lt;b&gt;Session store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[statestore.go; Lua]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;compare-and-set step, feed events and plug-in record in one call; in-memory store for tests&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="260" height="110" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Device reports&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[main.go, plug.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cp, telemetry, status, trace: plug-in and unplug, PWM charging, metering, presence&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="260" height="110" as="geometry"/></mxCell><mxCell id="ru" value="&lt;b&gt;Rule handlers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[rules.go, internal/rules]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rated and installation current, phases, meter, supply window; unknown keys stored, ignored&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="260" height="110" as="geometry"/></mxCell><mxCell id="hs" value="&lt;b&gt;Station state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[hotstate.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;settings and the limit in force per device; read by every answer and every send&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="410" width="260" height="110" as="geometry"/></mxCell><mxCell id="wr" value="&lt;b&gt;Background writers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[caches.go, presence.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;batches: telemetry, twin journal, presence (news only), acknowledgements&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="po" value="&lt;b&gt;Plug-in record and pool&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[pool.go; Lua in every event]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;per-device record; pool order ISO, DIN, PWM; departure, need, reaction&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="sf" value="&lt;b&gt;Final SoC read&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[socfinal.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DIN-only EV stopped by itself: 5 % once more, read the SoC, back to PWM&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="e3" value="device topics ($share/engine)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mq" target="d"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="v2g/down, cl/push" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm" target="mq"><mxGeometry x="0.3134" relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="115"/></Array></mxGeometry></mxCell><mxCell id="e5" value="v2g/up" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d" target="sm"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="load,&lt;br&gt;save step" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="sm" target="ss"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Lua: state&lt;br&gt;+ events" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1122;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="ss" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="bounds" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm" target="ru"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="limit in&lt;br&gt;force" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.8182;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm" target="hs"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="310"/><mxPoint x="990" y="465"/></Array></mxGeometry></mxCell><mxCell id="e10" value="read, write" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="hs" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="cp, telemetry,&lt;br&gt;status, trace" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d" target="rp"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="events" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.8182;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rp" target="po"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="500"/><mxPoint x="630" y="655"/></Array></mxGeometry></mxCell><mxCell id="e13" value="history" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rp" target="wr"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="batches" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="wr" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="record, pool, events" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="po" target="vk"><mxGeometry x="0.4563" relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="745"/><mxPoint x="1540" y="745"/></Array></mxGeometry></mxCell><mxCell id="e16" value="events" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8878;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sf" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="The answer to the EV touches Valkey and MQTT only (ADR-002); Postgres is written in the background. cmd/ack bypasses the device workers: confirmations are queued apart and written in batches. A status report also runs the supply rule (opens the device&#x27;s supply window). The final SoC read is started by a CP report and switches the CP mode through cp/set. Rule handlers read the rules that the registry reader (part 2) stores; a missing rule means the default behaviour. Square brackets name the file under engine/cmd/engine or the package under engine/internal.&lt;br&gt;&lt;b&gt;Key.&lt;/b&gt; Blue: the server and its parts (dark: the system; middle: containers; light: components); grey: outside the server; dark blue: a person; white: a runtime node. Solid line: request or message in normal work; dashed: asynchronous delivery or one-time setup; two arrowheads: both ways." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="1040" height="117" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4 L3 — Engine: control path"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1320" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Engine: components (C4 level 3), part 2 — registry, commands, activations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Edition 17.11.2026; checked against the code at commit 3e02749&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="50" as="geometry"/></mxCell><mxCell id="b2" value="Engine instance [Go]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontSize=13;fontStyle=1;fontColor=#555555;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="740" height="830" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;MQTT broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Mosquitto]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;registry/# from the layer; svc/blocked&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="660" height="70" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;devices with binding and rules; limits; activations, stages, targets; feed; notices&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="200" height="750" as="geometry"/></mxCell><mxCell id="vk" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pool, station state, activation jobs stream, members, leader lease&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="390" width="240" height="590" as="geometry"/></mxCell><mxCell id="rg" value="&lt;b&gt;Binding registry reader&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[registry.go; leader]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;applies a message only if binding_ver is higher; bound, unbound, revoked; digest check&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="280" height="110" as="geometry"/></mxCell><mxCell id="bl" value="&lt;b&gt;Device block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[block.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;operator command or revoked: every instance drops the device&amp;#x27;s messages; leader publishes the list&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="280" height="110" as="geometry"/></mxCell><mxCell id="sc" value="&lt;b&gt;Activation scheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[activations.go; leader]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stage start, pick, limits in one transaction, jobs at 5 000 a second fleet-wide, reports&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="280" height="110" as="geometry"/></mxCell><mxCell id="po" value="&lt;b&gt;Plug-in record and pool&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[pool.go; shared with part 1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;devices fit for an activation, in order&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="280" height="110" as="geometry"/></mxCell><mxCell id="ls" value="&lt;b&gt;Notice listener&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[main.go; LISTEN]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;limits, config, blocked, activations: a change goes to the device&amp;#x27;s owner instance at once&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="sn" value="&lt;b&gt;Activation senders&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[activations.go; 64 per instance]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;send a cache pair or a PWM limit; resend after 10 s without confirmation&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="lj" value="&lt;b&gt;Leader jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[main.go, retention.go; leader]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TTL renewal of active pairs every 300 s; feed kept 30 days&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="710" width="280" height="110" as="geometry"/></mxCell><mxCell id="hs" value="&lt;b&gt;Station state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[hotstate.go; shared with part 1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the limit in force: highest priority, then newest&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="710" width="280" height="110" as="geometry"/></mxCell><mxCell id="me" value="&lt;b&gt;Metrics and probes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[metrics.go; port 8090]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/metrics (Prometheus), /live, /ready, /health&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="870" width="280" height="110" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[coord.go]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;membership 2 s, leader lease 6 s, device owner for notices; drain on SIGTERM&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="870" width="280" height="110" as="geometry"/></mxCell><mxCell id="e3" value="registry/dev/{id},&lt;br&gt;registry/digest" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.2121;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mq" target="rg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="svc/blocked&lt;br&gt;(retained)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;