elative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="stages, limits,&lt;br&gt;targets" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2867;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="sc" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="LISTEN" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="pg" target="ls"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="new activation" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ls" target="sc"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="jobs via&lt;br&gt;Valkey stream" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.9091;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2727;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sc" target="sn"><mxGeometry x="-0.2579" relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="490"/><mxPoint x="650" y="580"/></Array></mxGeometry></mxCell><mxCell id="e13" value="limit,&lt;br&gt;config" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.8182;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ls" target="hs"><mxGeometry x="0.1778" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="640"/><mxPoint x="690" y="765"/></Array></mxGeometry></mxCell><mxCell id="e14" value="limit in force" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sn" target="hs"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="feed retention" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.7133;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="lj" target="pg"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.0932;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="po" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3644;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="sn" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.6356;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="hs" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.9068;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="co" target="vk"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Leader-only components (registry reader, scheduler, leader jobs) run on the instance that holds the lease kept by the coordinator; a new leader reads the retained registry again and continues activations from Postgres. Senders publish cl/push or power/set through the broker; the device confirms with cmd/ack (part 1). TTL renewal goes to the devices as ctrl. A block reaches the broker as a retained list, rewritten in batches every 3 s; the cost of many revocations at once has not been measured. Not built: a charging schedule per device (pause at 0 A, supply window as a schedule entry; ROADMAP item 2).&lt;br&gt;&lt;b&gt;Key.&lt;/b&gt; Blue: the server and its parts (dark: the system; middle: containers; light: components); grey: outside the server; dark blue: a person; white: a runtime node. Solid line: request or message in normal work; dashed: asynchronous delivery or one-time setup; two arrowheads: both ways." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1300" height="102" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Deployment — one host"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1080" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;ISO 15118 server: deployment on one host (Docker Compose), the reference configuration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Edition 17.11.2026; checked against the code at commit 3e02749&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="2280" height="50" as="geometry"/></mxCell><mxCell id="b2" value="Server VM [reference: 2 dedicated vCPU, 8 GB, NVMe; Linux, Docker Compose]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontSize=13;fontStyle=1;fontColor=#555555;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1680" height="640" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;mqtt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Mosquitto 2]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;8883 public, 1883 internal; up to 50 000 queued messages per client; volume mqtt-data&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="240" height="520" as="geometry"/></mxCell><mxCell id="vk" value="&lt;b&gt;valkey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Valkey 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AOF everysec, noeviction; maxmemory default 200 MB, 768 MB for the reference; volume valkey-data&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="110" width="240" height="110" as="geometry"/></mxCell><mxCell id="en" value="&lt;b&gt;engine × 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[docker compose up -d --scale engine=2]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;minimal configuration: one engine, the same file; :8090 metrics and probes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="pk" value="&lt;b&gt;pki-init, mqtt-init&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[one-shot; PKI_MODE own or layer]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CA or imported cloud root, broker certificate, passwords, ACL; volume pki&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="520" width="240" height="110" as="geometry"/></mxCell><mxCell id="rl" value="&lt;b&gt;relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stream limit EVENTS_STREAM_MAX&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="240" height="110" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Postgres 16]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;shared buffers default 96 MB, 1 GB for the reference; volume pg-data; backups are the operator&amp;#x27;s&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;projector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;one active&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="240" height="110" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[FastAPI, :8000]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;migrations at start&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Caddy; public 80, 443]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;TLS (Let&amp;#x27;s Encrypt), /v1, /health, rate limit; volume caddy-data&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#888888;fontColor=#000000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="dx" value="&lt;b&gt;Devices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Internet]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;client certificates&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="gx" value="&lt;b&gt;Test environment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[external system; test only]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;test harness and load generator, on other hosts&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="200" height="100" as="geometry"/></mxCell><mxCell id="lx" value="&lt;b&gt;Service layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Internet]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;publishes the registry&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="200" height="110" as="geometry"/></mxCell><mxCell id="ox" value="&lt;b&gt;Operator systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Internet]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;HTTPS /v1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="2060" y="310" width="220" height="100" as="geometry"/></mxCell><mxCell id="e3" value="8883 mTLS" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=default;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1058;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="