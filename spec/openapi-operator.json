{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud ISO 15118 server: operator API",
    "description": "Operator API of the cloud ISO 15118 server for the devices of the architecture.\n\nHeader `X-API-Key`; rights per key: `read`, `control`, `debug`. Device registry data (binding, type,\ncoarse location, business rules) comes from the service layer through the broker, not over HTTP.\nDevice settings: `GET|PUT /v1/devices/{id}/config` (fields: `GET /v1/config/fields`).\nReading: devices, plug-in sessions and the event feed come from tables filled\nasynchronously from the engines; every answer has `X-Data-Lag-Ms`, every row\nits `as_of`. Lists page by `cursor` = previous `next_cursor` until it is null.\nCommands are asynchronous (202 + `command_id`); the device confirms them and\nthe feed carries `limit.applied`. Event schema: `GET /v1/events/schema`.",
    "version": "1.0.0",
    "license": {
      "name": "Apache 2.0",
      "identifier": "Apache-2.0"
    }
  },
