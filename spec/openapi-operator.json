  "components": {
    "schemas": {
      "Activation": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "description": "your id; a repeated POST with the same id and body is safe"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/Stage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Stages"
          },
          "duration_s": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 60.0,
            "title": "Duration S",
            "description": "limits end this long after creation"
          },
          "priority": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Priority",
            "description": "the higher wins on a device (direct limits are 0)",
            "default": 50
          }
        },
        "type": "object",
        "required": [
          "selection",
          "level",
          "stages",
          "duration_s"
        ],
        "title": "Activation"
      },
      "Block": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200,
            "title": "Reason",
            "description": "why, for the audit and the device view",
            "default": ""
          }
        },
        "type": "object",
        "title": "Block"
      },
      "ConfigIn": {
        "properties": {
          "device": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "station": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "title": "ConfigIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Level": {
        "properties": {
          "current_a": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 6.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Current A",
            "description": "per phase, per device"
          },
          "power_kw": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Kw",
            "description": "per device"
          },
          "group_power_kw": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Power Kw",
            "description": "per stage, shared evenly by its devices"
          }
        },
        "type": "object",
        "title": "Level"
      },
      "Limit": {
        "properties": {
          "limit_a": {
            "type": "number",
            "title": "Limit A",
            "description": "per phase, A"
          },
          "duration_s": {
            "type": "integer",
            "title": "Duration S",
            "description": "how long the limit holds, s"
          }
        },
        "type": "object",
        "required": [
          "limit_a",
          "duration_s"
        ],
        "title": "Limit"
      },
      "Patch": {
        "properties": {
          "add_stages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Stage"
                },
                "type": "array",
                "maxItems": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Add Stages",
            "description": "compensation stages"
          },
          "extend_s": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Extend S",
            "description": "end later by this much"
          },
          "level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Level"
              },
              {
                "type": "null"
              }
            ],
            "description": "level for stages not started yet"
          }
        },
        "type": "object",
        "title": "Patch"
      },
      "Selection": {
        "properties": {
          "devices": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Devices",
            "description": "explicit list"
          },
          "online": {
            "type": "boolean",
            "title": "Online",
            "description": "only devices online at the stage start",
            "default": true
          },
          "charging": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Charging",
            "description": "true: only charging; false: only not charging"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(iso|din|pwm)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode",
            "description": "control mode of the plug-in"
          }
        },
        "type": "object",
        "title": "Selection"
      },
      "Stage": {
        "properties": {
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "At",
            "description": "start time; default: now + offset_s"
          },
          "offset_s": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Offset S",
            "description": "start after the activation is created",
            "default": 0
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Count",
            "description": "devices in this stage, or"
          },
          "share": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Share",
            "description": "share of the devices eligible at the start"
          },
          "spread_s": {
            "type": "number",
            "maximum": 600.0,
            "minimum": 0.0,
            "title": "Spread S",
            "description": "sends spread evenly over this time",
            "default": 0
          }
        },
        "type": "object",
        "title": "Stage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Operator key with rights read, control and/or debug (python -m app.keys create)"
      }
    }
  },
